rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Global Helpers
    // ===============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/jpc_users/$(uid)).data;
    }

    function hasUserDoc(uid) {
      return exists(/databases/$(database)/documents/jpc_users/$(uid));
    }

    function isCandidateMatch(candidateId) {
      return isSignedIn() && (
        candidateId == request.auth.uid ||
        (hasUserDoc(request.auth.uid) && getUserData(request.auth.uid).candidate_id == candidateId)
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ["paramatwork3076@gmail.com", "officialparamparmar@gmail.com"] ||
        (hasUserDoc(request.auth.uid) && getUserData(request.auth.uid).role in ['administrator', 'jpc_sysadmin'])
      );
    }

    function isManager() {
      return isSignedIn() && (
        isAdmin() ||
        (hasUserDoc(request.auth.uid) && getUserData(request.auth.uid).role in ['jpc_manager', 'jpc_sysadmin', 'administrator'])
      );
    }

    function isAurrumAdmin() {
      return isSignedIn() && hasUserDoc(request.auth.uid) && getUserData(request.auth.uid).role == 'aurrum_admin';
    }

    function isCS() {
      return isSignedIn() && hasUserDoc(request.auth.uid) && getUserData(request.auth.uid).role == 'jpc_cs';
    }

    function isRecruiter() {
      return isSignedIn() && hasUserDoc(request.auth.uid) && getUserData(request.auth.uid).role == 'jpc_recruiter';
    }

    function isProxy() {
      return isSignedIn() && hasUserDoc(request.auth.uid) && getUserData(request.auth.uid).role == 'jpc_proxy';
    }

    function isStaff() {
      return isSignedIn() && (
        request.auth.token.email in ["paramatwork3076@gmail.com", "officialparamparmar@gmail.com"] ||
        (hasUserDoc(request.auth.uid) && !(getUserData(request.auth.uid).role in ['candidate', 'jpc_candidate']))
      );
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // jpc_users
    match /jpc_users/{userId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isAdmin() || isAurrumAdmin() || isOwner(userId) || isManager() || isStaff());
      allow delete: if isAdmin() || isManager() || isAurrumAdmin();
    }

    // jpc_candidates
    match /jpc_candidates/{candidateId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin() || isManager() || isStaff() || isAurrumAdmin();
    }

    // jpc_applications
    match /jpc_applications/{appId} {
      allow read: if isSignedIn() && (isStaff() || isCandidateMatch(resource.data.candidate_id) || resource.data.candidate_id == request.auth.uid);
      allow create, update, delete: if isSignedIn();
    }

    // jpc_notifications
    match /jpc_notifications/{notifId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.recipient_id || isStaff() || isCandidateMatch(resource.data.recipient_id));
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && (isAdmin() || isManager() || isStaff() || isAurrumAdmin());
    }

    // jpc_feature_announcements
    match /jpc_feature_announcements/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // jpc_target_reductions
    match /jpc_target_reductions/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Requests and Logs
    match /jpc_resume_requests/{requestId} { 
      allow read, write: if isSignedIn();
    }
    match /jpc_prep_requests/{requestId} { 
      allow read, write: if isSignedIn();
    }
    match /jpc_report_logs/{logId} { 
      allow read, write: if isSignedIn(); 
    }
    match /jpc_activity_logs/{logId} { 
      allow read: if isSignedIn() && (isStaff() || isCandidateMatch(resource.data.candidate_id) || resource.data.candidate_id == request.auth.uid);
      allow write: if true; 
    }
    match /jpc_followups/{followId} { 
      allow read: if isSignedIn() && (isStaff() || isCandidateMatch(resource.data.candidate_id) || resource.data.candidate_id == request.auth.uid);
      allow write: if isSignedIn(); 
    }
    match /jpc_payments/{paymentId} { 
      allow read: if isSignedIn() && (isStaff() || isCandidateMatch(resource.data.candidate_id) || resource.data.candidate_id == request.auth.uid);
      allow write: if isSignedIn(); 
    }
    match /jpc_promises/{promiseId} { 
      allow read: if isSignedIn() && (isStaff() || isCandidateMatch(resource.data.candidate_id) || resource.data.candidate_id == request.auth.uid);
      allow write: if isSignedIn(); 
    }
    match /jpc_qc_checklist/{itemId} { 
      allow read, write: if isSignedIn(); 
    }
    match /jpc_interviews/{interviewId} { 
      allow read, write: if isSignedIn(); 
    }

    // Interview Support System
    match /jpc_interview_requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isSignedIn();
    }

    match /jpc_calendar_events/{eventId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isSignedIn();
    }

    match /jpc_interview_rounds/{roundId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isSignedIn();
    }

    match /jpc_proxy_availability/{availId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if true;
      allow delete: if isSignedIn();
    }

    match /jpc_interview_feedback/{feedbackId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /jpc_interview_booking_links/{linkId} {
      allow read, write: if true;
    }

    match /jpc_interview_notifications/{notId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    match /jpc_interview_activity_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow delete: if isSignedIn();
    }

    match /jpc_cv_files/{fileId} {
      allow read: if true;
      allow create, update, write: if true;
      allow delete: if isSignedIn();

      match /chunks/{chunkId} {
        allow read, create, update, write: if true;
        allow delete: if isSignedIn();
      }
    }
    
    match /jpc_rtr_requests/{requestId} {
      allow read, write: if isSignedIn();
    }
    
    match /jpc_interview_offer_requests/{requestId} {
      allow read, write: if isSignedIn();
    }

    match /jpc_settings/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
